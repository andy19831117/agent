# Canonical origin for sitemap.xml and robots.txt.
# Set this on the Vercel project for Production (and Preview, if previews
# should not use the production alias).
NEXT_PUBLIC_SITE_URL=https://agent-usecases-cn.vercel.app

# Newsletter via Resend Contacts + Segment.
# Audiences were renamed to Segments (Nov 2025). Create a Segment in the
# Resend Audience dashboard and paste its id. Do not commit real secrets.
# RESEND_FROM must be a verified sender, for example:
# Agent场景库 <news@yourdomain.com>
# SUBSCRIBE_TOKEN_SECRET signs double opt-in links (at least 16 random characters).
# Keep click tracking off on the sending domain so confirmation links are not rewritten.
RESEND_API_KEY=
RESEND_SEGMENT_ID=
RESEND_FROM=
SUBSCRIBE_TOKEN_SECRET=
