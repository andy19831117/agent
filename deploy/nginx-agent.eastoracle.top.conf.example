# 放到 Nginx 的 http 上下文中，例如：
#   /etc/nginx/conf.d/agent.eastoracle.top.conf
# map 只能写在 http 里，不能嵌进 server。
#
# 目标机 47.103.117.81。本文件只服务 agent.eastoracle.top，
# 不要改 news.eastoracle.top 的站点或发信。
#
# 证书：DNS 指向该 ECS 后执行
#   sudo certbot --nginx -d agent.eastoracle.top
# Certbot 会补上 listen 443 ssl 与证书路径。需要跳转时让 Certbot 打开 HTTP→HTTPS。

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name agent.eastoracle.top;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_cache_bypass $http_upgrade;

        # Cache Components 的流式响应不要被缓冲。
        proxy_buffering off;
    }
}
